{
  "name": "pw-bank-framework",
  "version": "1.0.0",
  "description": "Playwright UI, API, and hybrid test framework for SecureBank",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep-invert @smoke",
    "test:api": "playwright test --project=api",
    "test:flake": "playwright test --repeat-each=3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && playwright test --list",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "testing",
    "qa",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
