{
  "name": "pw-bank-framework",
  "version": "1.0.0",
  "description": "Production-style Playwright and TypeScript test automation framework for UI, API, and hybrid banking scenarios",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:interactive": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate": "npm run typecheck && npm run lint && npm run test:list",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "api-testing",
    "sdet"
  ],
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.1.11"
  }
}
